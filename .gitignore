# Dependencies
node_modules/
.npm/
.pnpm-store/

# Frontend build output and caches
dist/
dist-ssr/
.vite/
*.tsbuildinfo
coverage/
*.local

# Rust / Tauri build output (also holds test screenshots and build logs)
src-tauri/target/
target/

# Tauri generated schemas; recreated by the CLI
src-tauri/gen/

# Installers and packages (publish them on GitHub Releases instead)
*.exe
*.msi
*.msix
*.msixbundle
*.appx
*.appxbundle
*.rpm
*.deb
*.AppImage
*.dmg
*.zip
*.7z

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
installer-build.status

# Local environment and secrets
.env
.env.*
!.env.example
*.pfx
*.p12
*.cer
*.crt
*.key
*.pem
*.jks
*.keystore

# Local app and runtime data
*.sqlite
*.sqlite3
*.sqlite-journal
*.db
*.db-journal

# Editors
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# Operating system and OneDrive noise
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/
~$*

# Local notes (not published)
/docs/
